pipeline{
    agent any 
     tools{
         maven 'maven3'
     }
      environment {
        SONAR_URL = "http://100.31.115.230:8000/"
        DOCKER_IMAGE = "murthyvella/ultimate-cicd:${BUILD_NUMBER}"
        // DOCKERFILE_LOCATION = "java-maven-sonar-argocd-helm-k8s/spring-boot-app/Dockerfile"
        REGISTRY_CREDENTIALS = credentials('docker-cred')
        //deploment file update
        GIT_REPO_NAME = "java-maven-sonar-argocd-helm-k8s" 
        GIT_USER_NAME = "murthyvella"
      }
        stages{
            stage('code checkout') {
                steps {
                    checkout scmGit(branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/iam-veeramalla/Jenkins-Zero-To-Hero/']])
                }
            }
        stage('build and test'){
            steps{
                dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
                sh ' mvn clean package'
               }
            }
        }
        stage('code analysis'){
            steps{
                withCredentials([string(credentialsId: 'sonarqube', variable: 'sonarqube-pass')]) {
                  sh '''cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                        -Dsonar.projectKey=cicd-project \
                         -Dsonar.projectName='cicd-project' \
                         -Dsonar.host.url=http://100.31.115.230:8000/\
                         -Dsonar.token=squ_c5aeabeee24639b2b792a0e13ecfd0ab3e302a45 '''
               }
            }
        }
        stage('build &push'){
             steps {
              script {
              sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && docker build -t ${DOCKER_IMAGE} .'
               def dockerImage = docker.image("${DOCKER_IMAGE}")
                docker.withRegistry('https://index.docker.io/v1/', "docker-cred") {
                  dockerImage.push()
                }
             }
                
            }
        }
        stage('deploment file update'){
            steps{
                withCredentials([string(credentialsId: 'Github-Token', variable: 'github')]) {
                  sh '''  
                    git config user.email "murthyvella.xyz@gmail.com"
                    git config user.name "murthyvella"
                    BUILD_NUMBER=${BUILD_NUMBER}
                    sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                    git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                    git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                    git pull --rebase origin main
                    git push https://${github}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main '''
              }
                
            }
            
        }
    }
}
